HOST=127.0.0.1
PORT=3000
APP_ORIGIN=http://localhost:3000
DATA_DIR=./data
NODE_ENV=development
TRUST_PROXY=0
# Optional private monitoring socket. Parent directory must exist and be private.
# METRICS_SOCKET=/run/fantasytales/metrics.sock
# Optional custom private gallery location; match this in the rating worker.
# MEDIA_DIR=/var/lib/fantasytales/media
# ADMIN_USERNAME=site-admin
# Optional Search Console verification token; keep this file uncommitted.
# GOOGLE_SITE_VERIFICATION=
