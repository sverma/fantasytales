[Unit]
Description=Refresh Fantasy Tales offline DB-IP Lite country database
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=fantasytales-geodb
Group=fantasytales-geodb
StateDirectory=fantasytales-logwatch
StateDirectoryMode=0755
ExecStart=/usr/local/libexec/fantasytales-update-country
TimeoutStartSec=5min
UMask=0022
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
MemoryMax=256M
TasksMax=8
Nice=15
